# Copy this file to .env and fill in the values. Never commit .env.

# --- OpenSky Network ---
# Leave empty to use the anonymous API (very limited rate).
OPENSKY_CLIENT_ID=
OPENSKY_CLIENT_SECRET=
OPENSKY_POLL_INTERVAL_SECONDS=900
OPENSKY_MAX_RETRIES=3
OPENSKY_MIN_INTERVAL_SECONDS=10
# Optional bounding box "lamin,lomin,lamax,lomax" (smaller area = fewer API credits).
# Example (Egypt): 22,24,32,37
OPENSKY_BBOX=

# --- Data Lake (defaults to <project>/data) ---
# DATA_DIR=

# --- Spark ---
SPARK_MASTER=local[*]

# --- SQL Server ---
SQLSERVER_HOST=localhost
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=flight_dw
SQLSERVER_USER=sa
SQLSERVER_PASSWORD=ChangeMe_Str0ng!Pass

# --- Logging ---
LOG_LEVEL=INFO
